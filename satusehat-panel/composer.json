{
    "name": "satusehat/satusehat-panel",
    "description": "SATUSEHAT admin panel add-on for SIMRS Khanza",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "SatusehatPanel\\": "src/"
        },
        "classmap": [
            "src/Util/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SatusehatPanel\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "sync:lib": "php scripts/sync-lib.php --apply",
        "sync:lib:check": "php scripts/sync-lib.php --verify"
    }
}
