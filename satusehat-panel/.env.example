# ─── SIMRS Database (source of patient data) ──────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sik_bedah
DB_USER=root
DB_PASS=

# ─── SATUSEHAT API (same credentials as CLI, copied here) ─────────
SATUSEHAT_ORG_ID=
SATUSEHAT_CLIENT_ID=
SATUSEHAT_SECRET_KEY=
SATUSEHAT_AUTH_URL=https://api-satusehat-dev.dto.kemkes.go.id/oauth2/v1
SATUSEHAT_BASE_URL=https://api-satusehat-dev.dto.kemkes.go.id/fhir-r4/v1

# ─── App ──────────────────────────────────────────────────────────
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# Sub-folder deployment: auto-detected from SCRIPT_NAME by default.
# Set this ONLY if auto-detection needs an override behind a proxy/rewrite.
# APP_BASE_PATH=/satusehat-panel

# ─── SatuSehatConfig compat keys (used by adopted CLI logic) ──────
SATUSEHAT_TOKEN_TIMEOUT=3000
SATUSEHAT_DELAY_MS=500
SATUSEHAT_LOOKBACK_DAYS=0
SATUSEHAT_DATE_FROM=
SATUSEHAT_DATE_TO=
SATUSEHAT_BATCH_SIZE=500
SATUSEHAT_MEMORY_LIMIT=512M
SATUSEHAT_VERBOSE_PAYLOAD=false
# Log dir for adopted client (relative to panel root or absolute)
LOG_DIR=storage
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# ─── Panel Authentication ─────────────────────────────────────
# Shared password for the admin panel login. REQUIRED — if empty,
# nobody can log in (safe default, no auth bypass). Change this value!
PANEL_AUTH_PASSWORD=
